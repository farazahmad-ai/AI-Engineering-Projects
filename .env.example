# ==============================================================================
# Environment Variables Configuration
# Copy this file to `.env` and add your actual API keys below.
# DO NOT commit `.env` containing real keys to version control.
# ==============================================================================

# --- Core LLM & Multimodal API Keys ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- External Tool APIs ---
# OpenTripMap API Key (Used in AI Travel Assistant for tourist attractions lookup)
# Free key available at: https://opentripmap.io/product
OPENTRIPMAP_API_KEY=your_opentripmap_api_key_here

# Google Books API Key (Used in Book Search Assistant)
Google_Books_Key=your_google_books_api_key_here
